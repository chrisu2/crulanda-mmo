    { "id": "mining", "name": "Mining", "kind": "gather", "tool": "tool.pick", "verb": "Mine", "taught": "You hang the pick at your belt. You can now mine.", "description": "Ore lies in seams along the cliffs and on cave floors. It takes a pick and a strong back, and any smith will pay for what you carry out.", "canonStatus": "GAME-ONLY" },
