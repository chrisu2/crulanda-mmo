{
  "craftSlots": 2,
  "professions": [
    { "id": "mining", "name": "Mining", "kind": "gather", "tool": "tool.pick", "verb": "Mine", "taught": "You hang the pick at your belt. You can now mine.", "description": "Ore lies in seams along the cliffs and on cave floors. It takes a pick and a strong back, and any smith will pay for what you carry out.", "canonStatus": "GAME-ONLY" },
    { "id": "woodcutting", "name": "Woodcutting", "kind": "gather", "tool": "tool.hatchet", "verb": "Cut", "taught": "You hang the hatchet at your belt. You can now cut timber.", "description": "Wind-felled timber is anyone's to cut. It takes a hatchet. Standing trees are left to stand.", "canonStatus": "GAME-ONLY" },
    { "id": "herbalism", "name": "Herbalism", "kind": "gather", "verb": "Gather", "description": "Bare hands and a good eye. Herbs grow where the ground suits them, and grow back when picked.", "canonStatus": "GAME-ONLY" },
    { "id": "cooking", "name": "Cooking", "kind": "free", "station": "fire", "description": "Meat, flour and eggs become something worth eating at any fire: an inn's hearth, a bake oven, a cookfire. Everyone can cook. Few do it well.", "canonStatus": "GAME-ONLY" },
    { "id": "blacksmithing", "name": "Blacksmithing", "kind": "craft", "station": "forge", "trainerRole": "blacksmith", "description": "Ore to bars, and bars to blades and plate, at a forge. A craft takes years, and a body has time for two.",
      "learnAt": "Taken up at a forge: Vell's smithy in Oakhaven, the field anvil on the Peaks pass, Oska's bone-anvil on the Ashland Rim, Alder-Knot's ember-stone on the Verdant Shore. A blacksmith will start you off wherever you find one.",
      "takeUp": "You look over the anvil, the tongs and the quench tub, and begin.",
      "helping": "{name} works the bellows for you.",
      "trainerLines": [ { "npc": "Brannoc Vell", "text": "Mind the scale. Copper first; it forgives you." }, { "npc": "Oska", "text": "Bone teaches patience. Iron teaches the rest. Strike where it glows, not where you wish it did." }, { "npc": "Alder-Knot", "text": "Metal is only stone that has been listened to. Listen first, flesh-folk. Then strike." }, { "text": "Hammer, tongs and a steady arm. The rest is burns and practice." } ],
      "helpLines": [ { "npc": "Brannoc Vell", "text": "Pump it slow. Let the coals do the work." }, { "npc": "Oska", "text": "More air. Bone or iron, the fire wants feeding." }, { "npc": "Alder-Knot", "text": "Breathe with the fire. It is older than both of us." }, { "text": "Here, I'll keep the fire up for you." } ],
      "canonStatus": "GAME-ONLY" },
    { "id": "alchemy", "name": "Alchemy", "kind": "craft", "station": "bench", "trainerRole": "herbalist", "description": "Herbs to draughts, at a herbalist's bench. A craft takes years, and a body has time for two.",
      "learnAt": "Taken up at a herbalist's bench: Lisbet's drying hut in Oakhaven, Wenna Coyle's bench in Khaven, Mother Vane's salt-bench on the Ashland Rim, Moss-Lantern's bench on the Verdant Shore. A herbalist will start you off wherever you find one.",
      "takeUp": "You look over the jars, the mortar and the little still, and begin.",
      "helping": "{name} keeps the still at a simmer for you.",
      "trainerLines": [ { "npc": "Lisbet Crane", "text": "Never boil yarrow. Warm it, and wait. Start with that and you'll do." }, { "npc": "Wenna Coyle", "text": "Gloves for the cap, and don't breathe over the pot. Khaven buries enough as it is." }, { "text": "Clean vials and a slow fire. The herbs tell you the rest, if you listen." } ],
      "helpLines": [ { "npc": "Lisbet Crane", "text": "Lower. Lower than that. There." }, { "npc": "Wenna Coyle", "text": "Stir it the other way. Don't ask me why. It works." }, { "text": "Slowly. A draught won't be hurried." } ],
      "canonStatus": "GAME-ONLY" }
  ],
