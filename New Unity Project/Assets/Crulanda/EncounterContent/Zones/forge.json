  "landmarks": [
    {
      "name": "The Tithe Gate",
      "text": "The gate from the Lowtowns, open by day. The Copper-Tithe keep a booth on the inside and write down everyone who comes through, and what they carry, and what they owe.",
      "at": {
        "x": -166,
        "y": 0
      },
      "radius": 12,
      "canonStatus": "CANON-EXPANDED: the Copper-Tithe (book1 ch.1:145, ch.24:140); their gate GAME-ONLY",
      "view": {
        "x": -150,
        "y": -14
      },
      "viewPitch": 14,
      "viewZoom": 16
    },
    {
      "name": "The Rust & Ruin",
      "text": "A tavern behind an iron-banded oak door, down a lane where the light never quite reaches. Stale beer, smoke, and nobody asking your name.",
      "at": {
        "x": -132,
        "y": 24
      },
      "radius": 9,
      "canonStatus": "CANON: the Rust & Ruin, its iron-banded oak door (book1 ch.24:81-114); here in the Forge District GAME-ONLY",
      "view": {
        "x": -132,
        "y": 4
      },
      "viewPitch": 12,
      "viewZoom": 15
    },
    {
      "name": "The Forge Warrens",
      "text": "The smelters' lodgings: low stone rows under iron roofs, a family a room, the gutters black with soot. Valen grew up in gutters like these.",
      "at": {
        "x": -130,
        "y": -60
      },
      "radius": 30,
      "canonStatus": "CANON: the Forge District Warrens (book1 ch.3:159) and Valen's gutters (book1 ch.25:175); the rows GAME-ONLY",
      "view": {
        "x": -112,
        "y": -40
      },
      "viewPitch": 15,
      "viewZoom": 18
    },
    {
      "name": "The West Fire Pits",
      "text": "Pits of coals that never go out, ringed with blackened stone. The Blacklegs warm their hands here and watch the lodgings.",
      "at": {
        "x": -155,
        "y": -125
      },
      "radius": 14,
      "canonStatus": "CANON: the Fire Pits (the author's map); their use GAME-ONLY",
      "view": {
        "x": -136,
        "y": -104
      },
      "viewPitch": 14,
      "viewZoom": 15
    },
    {
      "name": "The River Aureum",
      "text": "A channel of molten gold-bright metal running down from the furnaces, behind a kerb of stone. The heat comes off it like a wall.",
      "at": {
        "x": -80,
        "y": 40
      },
      "radius": 16,
      "canonStatus": "CANON: the River Aureum (the author's map); GAME-ONLY course",
      "view": {
        "x": -100,
        "y": 30
      },
      "viewPitch": 13,
      "viewZoom": 15
    },
    {
      "name": "The Foundry",
      "text": "Long soot-stone halls with their arches glowing, the heavy Foundry where the Council raises the Spoke. Overseers with tally-sticks on every door.",
      "at": {
        "x": -40,
        "y": 100
      },
      "radius": 30,
      "canonStatus": "CANON: the Foundry District, where the Spoke is being built (book1 ch.7:237); its halls GAME-ONLY",
      "view": {
        "x": -60,
        "y": 100
      },
      "viewPitch": 15,
      "viewZoom": 18
    },
    {
      "name": "The Spoke",
      "text": "A rune-carved monolith of black stone, taller than anything in the district, its runes glowing like coals. It hums. The air near it tastes of copper.",
      "at": {
        "x": -12,
        "y": 0
      },
      "radius": 14,
      "canonStatus": "CANON: the Spoke, a rune-carved stone monolith (world_bible.md Magic; book1 ch.7:237); its look GAME-ONLY from the author's map",
      "view": {
        "x": -56,
        "y": 6
      },
      "viewPitch": 22,
      "viewZoom": 30
    },
    {
      "name": "The Molten Vein",
      "text": "The second channel of molten metal, out of the north and away south past the Spoke. The stone bridges over it are the only ways across.",
      "at": {
        "x": 40,
        "y": 30
      },
      "radius": 16,
      "canonStatus": "CANON: the Molten Vein (the author's map); GAME-ONLY course",
      "view": {
        "x": 24,
        "y": 20
      },
      "viewPitch": 13,
      "viewZoom": 15
    },
    {
      "name": "The Great Crucible",
      "text": "A stone bowl the size of a house, molten at the brim. Gangs pour it by ladle and by hand, a little at a time, all day and all night.",
      "at": {
        "x": 115,
        "y": 125
      },
      "radius": 12,
      "canonStatus": "CANON: the Great Crucible (the author's map); poured by hand GAME-ONLY",
      "view": {
        "x": 90,
        "y": 112
      },
      "viewPitch": 15,
      "viewZoom": 18
    },
    {
      "name": "The East Fire Pits",
      "text": "More pits of coals, and more Blacklegs round them. The smelters walk wide of this side.",
      "at": {
        "x": 138,
        "y": 24
      },
      "radius": 12,
      "canonStatus": "CANON: the Fire Pits (the author's map); GAME-ONLY",
      "view": {
        "x": 118,
        "y": 10
      },
      "viewPitch": 14,
      "viewZoom": 15
    },
    {
      "name": "The Slag Fields",
      "text": "Heaps of black slag cracked with ember, tipped out of the furnaces for a hundred years. The hounds live in them.",
      "at": {
        "x": 120,
        "y": -125
      },
      "radius": 30,
      "canonStatus": "CANON-EXPANDED: slag-piles (book1 ch.16:349); the fields GAME-ONLY",
      "view": {
        "x": 98,
        "y": -96
      },
      "viewPitch": 15,
      "viewZoom": 18
    }
  ],
